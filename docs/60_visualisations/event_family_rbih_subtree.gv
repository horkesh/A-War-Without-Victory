digraph event_family {
  rankdir=LR;
  node [shape=box, style=filled];
  edge [fontsize=8];

  // Legend
  subgraph cluster_legend {
    label="Legend";
    style=dashed;
    legend_rs [label="RS family", fillcolor=lightcoral];
    legend_rbih [label="RBiH family", fillcolor=lightblue];
    legend_hrhb [label="HRHB family", fillcolor=lightgreen];
    legend_cross [label="Cross-faction", fillcolor=lightyellow];
    legend_ring3 [label="Ring 3 sensitive", fillcolor=white, color=red, penwidth=2];
  }

  subgraph cluster__no_family_ {
    label="<no-family>";
    style=filled;
    color=white;
    "csq_bosniak_unity_1993" [label="csq_bosniak_unity_1993", fillcolor=white];
    "csq_civic_identity_consolidation_1993" [label="csq_civic_identity_consolidation_1993", fillcolor=white];
    "csq_international_disillusionment_1993" [label="csq_international_disillusionment_1993", fillcolor=white];
    "csq_minority_defections_1992" [label="csq_minority_defections_1992", fillcolor=white];
    "csq_paramilitary_authorization_refused" [label="csq_paramilitary_authorization_refused", fillcolor=white];
    "csq_pragmatic_coalition_1993" [label="csq_pragmatic_coalition_1993", fillcolor=white];
  }
  subgraph cluster_rbih_apwb_response {
    label="rbih_apwb_response";
    style=filled;
    color=lightblue;
    "abdic_apwb_declared_1993" [label="abdic_apwb_declared_1993", fillcolor=lightblue];
  }
  subgraph cluster_rbih_bihac_response {
    label="rbih_bihac_response";
