{
  "version": 8,
  "name": "AWWV Operations Map",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "hillshade-tiles": {
      "type": "raster",
      "url": "pmtiles:///data/derived/tiles/hillshade.pmtiles",
      "tileSize": 256,
      "minzoom": 6,
      "maxzoom": 12
    },
    "osm-tiles": {
      "type": "vector",
      "url": "pmtiles:///data/derived/tiles/osm.pmtiles"
    },
    "osid-control": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    },
    "mun-borders": {
      "type": "geojson",
      "data": "/data/source/boundaries/bih_adm3_1990.geojson"
    },
    "front-lines": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    },
    "formations": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    },
    "order-arrows": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ebe1cd"
      }
    },
    {
      "id": "earth-fill",
      "type": "fill",
      "source": "osm-tiles",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#e2d8c4",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "hillshade",
      "type": "raster",
      "source": "hillshade-tiles",
      "paint": {
        "raster-opacity": 0.5,
        "raster-resampling": "linear",
        "raster-fade-duration": 0
      }
    },
    {
      "id": "water-polygons",
      "type": "fill",
      "source": "osm-tiles",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "rgb(100, 150, 200)",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "forest",
      "type": "fill",
      "source": "osm-tiles",
      "source-layer": "landuse",
      "filter": ["in", ["get", "kind"], ["literal", ["forest", "park", "nature_reserve"]]],
      "paint": {
        "fill-color": "#b5c9a0",
        "fill-opacity": 0.15
      }
    },
    {
      "id": "waterway-lines",
      "type": "line",
      "source": "osm-tiles",
      "source-layer": "water",
      "filter": ["any",
        ["==", ["geometry-type"], "LineString"],
        ["==", ["geometry-type"], "MultiLineString"]
      ],
      "paint": {
        "line-color": "rgb(100, 150, 200)",
        "line-opacity": 0.7,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 12, 2.5]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "osm-tiles",
      "source-layer": "roads",
      "filter": ["in", ["get", "kind"], ["literal", ["highway", "major_road"]]],
      "paint": {
        "line-color": "rgba(80, 70, 60, 0.35)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.3, 10, 1, 14, 2],
        "line-opacity": 1
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "osm-tiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "medium_road"],
      "minzoom": 10,
      "paint": {
        "line-color": "rgba(80, 70, 60, 0.2)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.3, 14, 1],
        "line-opacity": 1
      }
    },
    {
      "id": "osid-control-fill",
      "type": "fill",
      "source": "osid-control",
      "paint": {
        "fill-color": [
          "match",
          ["get", "controller"],
          "RS", "rgba(180, 50, 50, 0.25)",
          "RBiH", "rgba(55, 140, 75, 0.25)",
          "HRHB", "rgba(50, 110, 170, 0.25)",
          "rgba(60, 60, 70, 0.15)"
        ]
      }
    },
    {
      "id": "osid-control-outline",
      "type": "line",
      "source": "osid-control",
      "paint": {
        "line-color": "rgba(40, 40, 50, 0.1)",
        "line-width": 0.3
      }
    },
    {
      "id": "faction-border-glow-pos",
      "type": "line",
      "source": "front-lines",
      "filter": ["all", ["==", ["get", "lineType"], "glow"], ["==", ["get", "offset_side"], 1]],
      "paint": {
        "line-color": [
          "match",
          ["get", "faction"],
          "RS", "rgba(180, 50, 50, 0.85)",
          "RBiH", "rgba(55, 140, 75, 0.85)",
          "HRHB", "rgba(50, 110, 170, 0.85)",
          "rgba(60, 60, 70, 0.4)"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 3, 10, 6, 14, 10],
        "line-blur": ["interpolate", ["linear"], ["zoom"], 6, 1, 10, 2, 14, 3],
        "line-offset": ["interpolate", ["linear"], ["zoom"], 6, 4, 10, 8, 14, 12],
        "line-opacity": 0.9
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "faction-border-glow-neg",
      "type": "line",
      "source": "front-lines",
      "filter": ["all", ["==", ["get", "lineType"], "glow"], ["==", ["get", "offset_side"], -1]],
      "paint": {
        "line-color": [
          "match",
          ["get", "faction"],
          "RS", "rgba(180, 50, 50, 0.85)",
          "RBiH", "rgba(55, 140, 75, 0.85)",
          "HRHB", "rgba(50, 110, 170, 0.85)",
          "rgba(60, 60, 70, 0.4)"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 3, 10, 6, 14, 10],
        "line-blur": ["interpolate", ["linear"], ["zoom"], 6, 1, 10, 2, 14, 3],
        "line-offset": ["interpolate", ["linear"], ["zoom"], 6, -4, 10, -8, 14, -12],
        "line-opacity": 0.9
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "front-line-base",
      "type": "line",
      "source": "front-lines",
      "filter": ["==", ["get", "lineType"], "front"],
      "paint": {
        "line-color": "#252220",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.8, 10, 3.0, 14, 4.2],
        "line-opacity": 0.9
      },
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      }
    },
    {
      "id": "front-line-stripe",
      "type": "line",
      "source": "front-lines",
      "filter": ["==", ["get", "lineType"], "front"],
      "paint": {
        "line-color": "#e8ddd0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.0, 10, 1.8, 14, 2.6],
        "line-opacity": 0.85,
        "line-dasharray": [4, 3]
      },
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      }
    },
    {
      "id": "attack-arrows",
      "type": "line",
      "source": "order-arrows",
      "filter": ["==", ["get", "type"], "attack"],
      "paint": {
        "line-color": "rgba(196, 48, 48, 0.85)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.2, 10, 2.6, 14, 3.8],
        "line-opacity": 0.9
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "movement-arrows",
      "type": "line",
      "source": "order-arrows",
      "filter": ["==", ["get", "type"], "movement"],
      "paint": {
        "line-color": "rgba(62, 168, 95, 0.8)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 10, 2, 14, 3],
        "line-opacity": 0.85,
        "line-dasharray": [3, 2]
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "mun-borders",
      "type": "line",
      "source": "mun-borders",
      "paint": {
        "line-color": "rgba(80, 60, 40, 0.35)",
        "line-width": 1.5,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "formation-markers",
      "type": "symbol",
      "source": "formations",
      "layout": {
        "icon-image": ["get", "icon_id"],
        "icon-size": ["interpolate", ["linear"], ["zoom"], 6, 0.42, 10, 0.62, 14, 0.8],
        "icon-allow-overlap": false,
        "icon-ignore-placement": false
      },
      "paint": {
        "icon-opacity": 0.96
      }
    },
    {
      "id": "formation-labels",
      "type": "symbol",
      "source": "formations",
      "minzoom": 9,
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 14, 12],
        "text-anchor": "top",
        "text-offset": [0, 0.9],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "rgba(20, 20, 20, 0.9)",
        "text-halo-color": "rgba(235, 225, 205, 0.85)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels-city",
      "type": "symbol",
      "source": "osm-tiles",
      "source-layer": "places",
      "filter": ["in", ["get", "kind"], ["literal", ["city", "town"]]],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"],
          6, ["match", ["get", "kind"], "city", 13, 10],
          10, ["match", ["get", "kind"], "city", 16, 12],
          14, ["match", ["get", "kind"], "city", 18, 14]
        ],
        "text-anchor": "center",
        "text-allow-overlap": false,
        "text-optional": true,
        "text-padding": 4
      },
      "paint": {
        "text-color": "rgba(40, 30, 20, 0.85)",
        "text-halo-color": "rgba(235, 225, 205, 0.9)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels-village",
      "type": "symbol",
      "source": "osm-tiles",
      "source-layer": "places",
      "minzoom": 10,
      "filter": ["==", ["get", "kind"], "village"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 9, 14, 11],
        "text-anchor": "center",
        "text-allow-overlap": false,
        "text-optional": true,
        "text-padding": 2
      },
      "paint": {
        "text-color": "rgba(60, 50, 40, 0.7)",
        "text-halo-color": "rgba(235, 225, 205, 0.85)",
        "text-halo-width": 1.2
      }
    }
  ]
}
