{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["src", "tests"],
  "exclude": [
    "dist",
    "node_modules",
    "src/ui/map/.storybook",
    "src/ui/map/stories",
    "src/ui/map/__mocks__",
    "src/ui/map/saved"
  ]
}
