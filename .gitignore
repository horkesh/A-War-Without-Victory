# Windows reserved names (accidental creation)
NUL

# Log files
*.log

# Python cache
tools/**/__pycache__/
*.pyc

# Save files (individual saves, but keep saves/ directory tracked)
saves/save_*.json

# Node modules
node_modules/

dist-packaged/

# Build outputs
dist/
coverage/

# build/ holds electron-builder source assets (committed) AND staged
# packager output (ignored). Re-ignore the staged subdirs explicitly so the
# committed source icons can land while build outputs stay ignored.
# (LANE-V095-PLATFORM-ICON-APPID.)
build/*-unpacked/
build/*-arm64-unpacked/
build/win-ia32-unpacked/
build/linux-unpacked/
build/mac/
build/__icon_gen_temp.cjs

# Allow tooling under tools/build/ (build-related scripts, not build outputs)
!tools/build/
!tools/build/**

# Generated audit/debug artifacts (do not track)
data/derived/_debug/
data/derived/_test/

# Viewer geometry (presentation-only, not committed - Phase H3.7, H4.2, H4.5)
data/derived/settlements_viewer_v1.geojson
data/derived/settlements_viewer_v1.geojson.gz
data/derived/municipalities_viewer_v1.geojson
data/derived/municipalities_viewer_v1.geojson.gz
data/derived/municipalities_mun1990_viewer_v1.geojson
data/derived/municipalities_mun1990_viewer_v1.geojson.gz
# Archived/deprecated docs (kept locally, not committed)
docs/_old/
docs/cleanup/
docs/40_reports/convenes/_archived_feb2026/
docs/40_reports/implemented/_archived_feb2026/

# Phase H6.2 terrain snapshot temp files
data/derived/terrain/_tmp/

# Phase H1.1 scenario determinism test temp dirs
.tmp_scenario_test_a/
.tmp_scenario_test_b/

# Temporary diagnostic scripts (one-off session artifacts)
tools/tmp_*.cjs

# Codex temp diagnostic artifacts (do not track)
.codex_tmp*
tmp_gui_observation/

# Sector audit snapshots (research only, do not track)
tmp_sector_audit/

# Repo cleanup 2026: run outputs and temp dirs (do not track)
runs/
runs_perf/
.tmp_*/

# Handoff inbox artifacts — ephemeral, generated per run (keep .gitkeep)
handoffs/inbox/*.json
runs_ops_compare/
runs_probe/
runs_ivd_off/
runs_ivd_on/
data/derived/scenario/_baseline_tmp/
data/derived/scenario/_*/

