#!/bin/sh

# RE scope lock RETIRED 2026-08-31 by owner direction ("Close the lock, not
# needed any more"). The RE-PLANNING-DURATION-BUDGET packet had already recorded
# terminal_receipt.status=complete_by_owner_guard_bypass, but the lock stayed
# status=active pinned to a base 23 commits behind the line, so the checker
# rejected every file-changing commit while its SEALED branch passed only on a
# clean tree. scripts/repo/check_re_scope.ps1 is retained; reinstate the lane
# with scripts/repo/install_re_scope_hook.ps1 and a fresh RE_SCOPE_LOCK.json.

# Typecheck code/data commits, but do not block docs-only architecture commits
# on unrelated WIP in a shared Claude/Codex checkout.
staged_file_list="${TMPDIR:-/tmp}/awwv-precommit-staged-$$.txt"
git diff --cached --name-only --diff-filter=ACMR > "$staged_file_list"

needs_typecheck=0
while IFS= read -r staged_file; do
  [ -z "$staged_file" ] && continue
  case "$staged_file" in
    *.md|docs/*|.claude/napkin.md|.husky/*)
      ;;
    *)
      needs_typecheck=1
      break
      ;;
  esac
done < "$staged_file_list"
rm -f "$staged_file_list"

if [ "$needs_typecheck" -eq 0 ]; then
  echo "pre-commit: docs/process-only staged changes; skipping npx tsc --noEmit"
  exit 0
fi

# Typecheck code/data changes (fast fail ~15s)
npx tsc --noEmit

