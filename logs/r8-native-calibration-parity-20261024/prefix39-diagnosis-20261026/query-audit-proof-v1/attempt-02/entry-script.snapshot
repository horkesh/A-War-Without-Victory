#!/usr/bin/env node
'use strict';const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');const{pathToFileURL}=require('node:url');
const ROOT='C:/Users/User/.codex/worktrees/october-calibration-checkpoint/A-War-Without-Victory',SRC='src/desktop/desktop_sim.ts',WAR='src/sim/turn_phases/war_phases.ts';
const I=[['turn-016','tmp-paradox-qa-20260710/evidence/fractional-fatigue-p03-rbih-t39-01/rbih/turn-autosaves/turn-016.json','4756685','861d4e34a4b4c22c15db6fa857449c7f5bd68deb352edbb2a0059c6960ac07e3'],['turn-025','tmp-paradox-qa-20260710/evidence/fractional-fatigue-p03-rbih-t39-01/rbih/turn-autosaves/turn-025.json','5146025','d384bd9f7f24ebd044fd13bc3b123ad05f51aa074c0d44faedbe99075ac6adcc'],['turn-030','tmp-paradox-qa-20260710/evidence/fractional-fatigue-p03-rbih-t39-01/rbih/turn-autosaves/turn-030.json','5218514','2cf9f899f9287f5eeffd631a641f0446449d03fa7b01721a75ebc1ace2588c4f'],['final-039','tmp-paradox-qa-20260710/evidence/fractional-fatigue-p03-rbih-t39-01/rbih/final-autosave.json','5364177','623cbaed0e6186bc5f2c4a18fd5e9b22836db9343df0e4122316c92e5c9902e8']];
const T=[['op:foca:donje_zesce','RS'],['op:trnovo:tosici','RS']],sha=b=>crypto.createHash('sha256').update(b).digest('hex'),abs=p=>path.isAbsolute(p)?p:path.resolve(ROOT,p),row=p=>{const b=fs.readFileSync(p);return{path:p.replaceAll('\\','/'),bytes:b.length,sha256:sha(b)}},put=(p,x)=>fs.writeFileSync(p,JSON.stringify(x,null,2)+'\n',{flag:'wx'}),ok=(x,m)=>{if(!x)throw Error(m)};
async function main(){const out=path.resolve(process.argv[2]);ok(path.normalize(process.cwd()).toLowerCase()===path.normalize(ROOT).toLowerCase(),'root');ok(process.version==='v22.23.2','node');const source=row(abs(SRC)),war=row(abs(WAR)),loader=row(abs('node_modules/tsx/dist/loader.mjs'));const inputs=I.map(([label,rel,bytes,h])=>{const a=row(abs(rel));ok(String(a.bytes)===bytes&&a.sha256===h,'input hash '+label);return{label,path:rel,actual:a,expected:{bytes:+bytes,sha256:h}}});put(path.join(out,'PRECHECK.json'),{schema:'awwv.later-native-force-query.precheck.v1',root:ROOT,node:{version:process.version,executable:process.execPath},source,warPhases:war,loader,inputs,targets:T,queryOnly:true});const sim=await import(pathToFileURL(abs(SRC)).href);for(const n of['loadStateFromPath','serializeRuntimeState','deserializeState','queryDirectiveObjection','listBlockingPlayerDecisions'])ok(typeof sim[n]==='function',n);const results=[];for(const input of inputs){const loaded=await sim.loadStateFromPath(abs(input.path),ROOT),state=sim.deserializeState(sim.serializeRuntimeState(loaded.state)),turn=input.label==='final-039'?39:+input.label.slice(5);ok(state.meta?.turn===turn&&state.meta?.player_faction==='RBiH','identity '+input.label);const blockers=sim.listBlockingPlayerDecisions(state);ok(Array.isArray(blockers)&&!blockers.length,'blocker '+input.label);const committed=new Set;for(const c of Object.values(state.military?.corps_command??{}))for(const op of c?.active_operations??[]){for(const id of op?.participating_brigades??[])committed.add(id);for(const a of op?.axes??[])for(const id of a?.assigned_brigades??[])committed.add(id)}const ids=Object.keys(state.military?.corps_command??{}).filter(id=>/^arbih_[1-5]_corps$/.test(id)).sort();ok(JSON.stringify(ids)===JSON.stringify(['arbih_1st_corps','arbih_2nd_corps','arbih_3rd_corps','arbih_4th_corps','arbih_5th_corps']),'corps '+input.label);const stat=ids.map(c=>{const fsx=Object.values(state.military.formations??{}).filter(f=>f?.kind==='brigade'&&f?.faction==='RBiH'&&f?.corps_id===c&&f?.status==='active'&&!committed.has(f.id)),n=fsx.filter(f=>f.enclave_id==null&&typeof f.location_osid==='string'),g=n.filter(f=>Number.isFinite(f.personnel)&&f.personnel>=500),cmd=state.military.corps_command[c];return{corpsId:c,activeOperations:(cmd?.active_operations??[]).length,commandSpan:cmd?.command_span??null,normalAvailableActiveUncommittedCount:n.length,normalAvailableActiveUncommittedPersonnelGe500Count:g.length,normalAvailableActiveUncommittedPersonnelGe500Ids:g.map(f=>f.id).sort(),normalAvailableActiveUncommittedPersonnelTotal:n.reduce((s,f)=>s+(Number.isFinite(f.personnel)?f.personnel:0),0)}});put(path.join(out,input.label+'-STATIC.json'),{snapshot:input.label,turn,blockers,corps:stat});for(const[c,targetController]of T)for(const corpsId of ids){const qs=sim.deserializeState(sim.serializeRuntimeState(state)),before=sim.serializeRuntimeState(qs),objection=await sim.queryDirectiveObjection(qs,{corpsId,targetOsid:c},ROOT),after=sim.serializeRuntimeState(qs);ok(before===after,'mutation '+input.label+corpsId+c);ok(objection&&['launch','delay','abort'].includes(objection.recommendedAction)&&Number.isFinite(objection.forceRatio)&&Number.isFinite(objection.estimatedCasualties),'malformed query');results.push({snapshot:input.label,turn,corpsId,targetOsid:c,targetController,queryPurity:{pass:true,beforeBytes:Buffer.byteLength(before),afterBytes:Buffer.byteLength(after),beforeSha256:sha(Buffer.from(before)),afterSha256:sha(Buffer.from(after))},objection,staticCorroboration:stat.find(x=>x.corpsId===corpsId)})}}put(path.join(out,'RESULT.json'),{schema:'awwv.later-native-force-query.result.v1',root:ROOT,source,warPhases:war,inputs,targets:T,queryCount:results.length,results,verdict:'QUERY_ONLY_COMPLETE_NO_ADMISSION_OR_CAPTURE_CLAIM'});process.stdout.write(JSON.stringify({queryCount:results.length,snapshots:inputs.length,corps:5,targets:2})+'\n')}main().catch(e=>{process.stderr.write(`${e.stack??e}\n`);process.exitCode=2});


