'use strict';

const { spawnSync } = require('node:child_process');
const path = require('node:path');

const repo = path.resolve(__dirname, '..', '..', '..');
for (const file of ['tools/ui/cdp_network_collector.cjs', 'tools/ui/paradox_local_qa.cjs']) {
  const result = spawnSync(process.execPath, ['--check', path.join(repo, file)], {
    cwd: repo,
    stdio: 'inherit',
    windowsHide: true,
  });
  if (result.status !== 0) process.exit(result.status ?? 1);
}
