# Auto detect text files and perform LF normalization.
* text=auto

# Source, docs, data, and web assets use LF across platforms.
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.claude/current-lane.txt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
data/source/boundaries/bih_adm0.geojson text eol=lf
data/source/boundaries/geoboundaries_adm0_2023/*.geojson text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.husky/* text eol=lf
*.ps1 text eol=lf

data/derived/startup/*.json text eol=lf
logs/branch-hygiene/20260924-parallel-audit/r8-uncommitted.patch -text -diff
*.pmtiles filter=lfs diff=lfs merge=lfs -text
*.osm.pbf filter=lfs diff=lfs merge=lfs -text

logs/r8-native-calibration-parity-20261026/initial-calibration-packet/** -text -diff
# Preserve the archived R8 draft patch's recorded SHA-256 on every checkout.
logs/branch-hygiene/20260924-parallel-audit/r8-uncommitted.patch -text

# Keep the pinned audio sample license hash stable on Windows checkouts.
docs/audio/LICENSES/VSCO-2-CE-CC0.txt text eol=lf

# Keep revised sampled-score source freezes stable on Windows checkouts.
tools/audio/create_campaign_suite_v2.py text eol=lf
tools/audio/test_campaign_suite_v2.py text eol=lf
